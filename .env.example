# ScamSniff Server Configuration
PORT=5000
MONGODB_URI=mongodb://localhost:27017/scamsniff

# LLM Configuration (OpenAI Compatible API, Optional)
# If left blank or unconfigured, ScamSniff uses its built-in offline rule-based detection engine
LLM_API_KEY=
LLM_MODEL=gpt-3.5-turbo
LLM_BASE_URL=https://api.openai.com/v1

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
NODE_ENV=development
