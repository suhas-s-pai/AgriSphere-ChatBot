# AgriSphere Server Configuration
PORT=5001
MONGODB_URI=mongodb://localhost:27017/agrisphere

# Google Gemini API Integration (@google/genai)
# Get key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Legacy / Alternative LLM Configuration
# If unconfigured, AgriSphere uses its built-in offline agriculture engine
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
NODE_ENV=development
