# AgriSphere Server Configuration
PORT=5000
MONGODB_URI=mongodb://localhost:27017/agrisphere

# LLM Configuration (OpenAI or Gemini Vision Compatible API)
# If unconfigured, AgriSphere uses its built-in offline agriculture rule engine
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
NODE_ENV=development
